# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# MONGODB_URI: MongoDB connection string for persistent cloud/local database
# e.g., mongodb+srv://username:password@cluster0.mongodb.net/aurahumanize?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/aurahumanize"

# JWT_SECRET: Secret key for signing JSON Web Tokens (compatible with React Native / Android)
JWT_SECRET="aurahumanize-super-secret-jwt-key-2025"
